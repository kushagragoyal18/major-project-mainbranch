# -----------------------------------------------------------------------------
# Configuration Environment Variables
# Copy this to .env and configure as needed.
# -----------------------------------------------------------------------------

# Flask Configurations
FLASK_APP=server/app.py
FLASK_ENV=development
FLASK_DEBUG=1
JWT_SECRET=your-jwt-secret-here-make-it-secure-and-long

# MongoDB Configurations
MONGO_URI=mongodb://localhost:27017/secure_storage

# ABE Mode selection (real | simulated)
# Use 'real' inside Docker where Charm-Crypto is compiled.
# Use 'simulated' for local run without Charm-Crypto dependencies.
ABE_MODE=simulated

# Storage Options
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=./local_storage

# AWS S3 Storage Credentials (only needed if USE_LOCAL_STORAGE=false)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name

# Azure Blob Storage Credentials (alternative to S3)
AZURE_CONNECTION_STRING=your-azure-connection-string
AZURE_CONTAINER_NAME=your-azure-container-name
